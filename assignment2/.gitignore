# Ignore entire dataset content but keep dataset folder structure
dataset/*
!dataset/.gitkeep

# Checkpoints / Model weights (ignore heavy weights, preserve logs and metrics)
checkpoints/**/*.pt
checkpoints/**/*.pth
*.pt
*.pth
!checkpoints/.gitkeep

# Python cache & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.env
venv/
env/
.venv/

# Data archives
*.zip
*.tar.gz
*.tar

command.md

src/__train.py
